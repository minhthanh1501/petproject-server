NODE_ENV=development
PORT=3000
GLOBAL_PREFIX=api

# Comma-separated; empty disables CORS entirely.
CORS_ORIGINS=http://localhost:5173

# Base of the QR link handed to the customer at the counter. A wrong value here
# prints thousands of dead QR codes before anyone notices, so it is URL-validated
# at boot.
PUBLIC_BASE_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=mydatabase
DB_USERNAME=admin
DB_PASSWORD=petproject
DB_LOGGING=false
DB_SYNCHRONIZE=false

# Must differ from each other, or a refresh token could be replayed as an access
# token. Minimum 32 characters; the app refuses to boot otherwise.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

SWAGGER_ENABLED=true

# REDIS_PASSWORD is also read directly by docker-compose.yaml (--requirepass
# and the healthcheck) - keep it in sync with the credential embedded below.
REDIS_PASSWORD=change-me-redis-password

# Full URI, not a bare hostname — this is what @keyv/redis expects, and the only
# form that can carry credentials and a database index. Use rediss:// for TLS.
# No username before the password: --requirepass only sets Redis's built-in
# "default" user, and a client-supplied username here would fail AUTH.
# Boot fails fast if this is malformed.
REDIS_URL=redis://:change-me-redis-password@localhost:6379

# MILLISECONDS. cache-manager v7 changed this unit from seconds; a value copied
# from an older config would be 1000x too short. 300000 = 5 minutes.
REDIS_DEFAULT_TTL=300000

# Key prefix, so several environments can share one Redis without reading each
# other's entries and a single environment can be flushed alone.
REDIS_NAMESPACE=study-booth
